# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# App queries: pooled Prisma Postgres URL.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"
# CLI / migrations: direct Prisma Postgres URL (same credentials, different host).
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=verify-full"
